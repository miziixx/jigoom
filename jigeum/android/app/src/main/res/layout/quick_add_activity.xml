<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1 위젯 빠른 추가 팝업. 반투명 배경 위 각진 카드. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/qa_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F4F1EA"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="빠른 추가"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:textSize="11sp"
            android:textColor="#9A948A"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/qa_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="무엇을 하나요?"
            android:textSize="16sp"
            android:inputType="text"
            android:maxLines="2"
            android:background="@null"
            android:paddingBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D8D2C6"
            android:layout_marginBottom="10dp" />

        <Spinner
            android:id="@+id/qa_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />

        <CheckBox
            android:id="@+id/qa_all_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="종일"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/qa_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="취소"
                android:textSize="13sp"
                android:background="@null"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/qa_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="저장"
                android:textSize="13sp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:background="#26241F" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 홈에서 뜨는 빠른 담기 팝업(에디토리얼). 할일·일정·메모를 앱 없이 바로 담는다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="22dp"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/qa_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/quick_add_card_bg"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!-- eyebrow -->
        <TextView
            android:id="@+id/qa_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK ADD"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:textSize="9sp"
            android:textColor="#9A948A" />

        <!-- 제목(세리프 느낌) -->
        <TextView
            android:id="@+id/qa_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="빠르게 담기"
            android:fontFamily="serif"
            android:textSize="21sp"
            android:textColor="#26241F"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="16dp" />

        <!-- 종류 선택: 할일 · 일정 · 메모 (밑줄 탭) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/qa_type_todo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="7dp">
                <TextView
                    android:id="@+id/qa_type_todo_t"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="할 일"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:textSize="13sp"
                    android:textColor="#26241F" />
                <View
                    android:id="@+id/qa_ul_todo"
                    android:layout_width="26dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="#4E6659" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qa_type_schedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="7dp">
                <TextView
                    android:id="@+id/qa_type_schedule_t"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="일정"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:textSize="13sp"
                    android:textColor="#9A948A" />
                <View
                    android:id="@+id/qa_ul_schedule"
                    android:layout_width="26dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="#00000000" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qa_type_memo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="7dp">
                <TextView
                    android:id="@+id/qa_type_memo_t"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="메모"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:textSize="13sp"
                    android:textColor="#9A948A" />
                <View
                    android:id="@+id/qa_ul_memo"
                    android:layout_width="26dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="#00000000" />
            </LinearLayout>
        </LinearLayout>

        <!-- 입력 -->
        <EditText
            android:id="@+id/qa_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="할 일을 적어요"
            android:textSize="16sp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:background="@null"
            android:paddingBottom="9dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E1D7" />

        <!-- 일정 전용: 기간(시작~종료) + 캘린더 + 종일 -->
        <LinearLayout
            android:id="@+id/qa_schedule_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <!-- 기간 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기간"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:textSize="10sp"
                    android:textColor="#9A948A"
                    android:layout_marginEnd="14dp" />
                <TextView
                    android:id="@+id/qa_date_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textColor="#26241F"
                    android:background="@drawable/quick_add_chip_bg"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="–"
                    android:textSize="14sp"
                    android:textColor="#9A948A"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />
                <TextView
                    android:id="@+id/qa_date_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textColor="#26241F"
                    android:background="@drawable/quick_add_chip_bg"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp" />
            </LinearLayout>

            <Spinner
                android:id="@+id/qa_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <CheckBox
                android:id="@+id/qa_all_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="종일"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/qa_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="취소"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#9A948A"
                android:paddingLeft="12dp"
                android:paddingRight="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/qa_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="담기"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#F4F1EA"
                android:background="@drawable/quick_add_save_bg"
                android:paddingLeft="26dp"
                android:paddingRight="26dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

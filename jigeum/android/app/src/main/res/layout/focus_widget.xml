<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- 빠른 담기 캐럿 › — 앱의 프롬프트 시그니처.
             벡터 드로어블은 RemoteViews(특히 삼성 One UI 런처)에서 인플레이트에
             실패해 위젯이 빈 박스로 뜨므로, 모노 텍스트 캐럿으로 대체한다. -->
        <TextView
            android:id="@+id/widget_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#B5443A"
            android:includeFontPadding="false"
            android:contentDescription="빠른 담기"
            android:layout_marginEnd="12dp"
            android:text="›" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textAllCaps="true"
                android:letterSpacing="0.14"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#B5443A"
                android:layout_marginBottom="3dp"
                android:text="NOW" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textColor="#26241F"
                android:text="오늘 할 일을 정해볼까요" />
        </LinearLayout>

        <!-- 오른쪽 끝 마이크 — 이 칸만 음성 캡처(나머지는 빠른 담기). -->
        <TextView
            android:id="@+id/widget_mic"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="4dp"
            android:textSize="18sp"
            android:contentDescription="음성으로 담기"
            android:text="🎙" />
    </LinearLayout>
</FrameLayout>

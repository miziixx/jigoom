<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 생성 설정 바텀시트 — 투명도 · 글자 크기 · 테마 (모든 위젯 공통). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/widget_sheet_bg"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="26dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#DAD2C3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WIDGET"
            android:fontFamily="monospace"
            android:letterSpacing="0.16"
            android:textSize="9sp"
            android:textColor="#9A948A" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="위젯 꾸미기"
            android:fontFamily="serif"
            android:textSize="22sp"
            android:textColor="#26241F"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="18dp" />

        <!-- 배경 진하기 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="배경 진하기"
            android:textSize="13sp"
            android:textColor="#26241F" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="완전 투명" android:fontFamily="monospace"
                android:textSize="10sp" android:textColor="#9A948A" />
            <TextView android:id="@+id/cfg_pct" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="40%" android:fontFamily="monospace"
                android:textSize="12sp" android:textColor="#D6852A" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end" android:text="꽉 참" android:fontFamily="monospace"
                android:textSize="10sp" android:textColor="#9A948A" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/cfg_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="40"
            android:progressTint="#D6852A"
            android:thumbTint="#D6852A" />

        <!-- 글자 크기 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="글자 크기"
            android:textSize="13sp"
            android:textColor="#26241F"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/cfg_f0" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="7dp" android:gravity="center"
                android:paddingTop="10dp" android:paddingBottom="10dp" android:text="작게"
                android:fontFamily="monospace" android:textSize="12sp"
                android:background="@drawable/w_chip_off" android:textColor="#26241F" />
            <TextView android:id="@+id/cfg_f1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="7dp" android:gravity="center"
                android:paddingTop="10dp" android:paddingBottom="10dp" android:text="보통"
                android:fontFamily="monospace" android:textSize="12sp"
                android:background="@drawable/w_chip_on" android:textColor="#F4F1EA" />
            <TextView android:id="@+id/cfg_f2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:paddingTop="10dp" android:paddingBottom="10dp" android:text="크게"
                android:fontFamily="monospace" android:textSize="12sp"
                android:background="@drawable/w_chip_off" android:textColor="#26241F" />
        </LinearLayout>

        <!-- 테마 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="테마"
            android:textSize="13sp"
            android:textColor="#26241F"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/cfg_themes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="22dp">
            <TextView android:id="@+id/cfg_cancel" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="취소" android:fontFamily="monospace"
                android:textSize="13sp" android:textColor="#9A948A"
                android:paddingLeft="14dp" android:paddingRight="18dp"
                android:paddingTop="13dp" android:paddingBottom="13dp" />
            <TextView android:id="@+id/cfg_ok" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="확인" android:fontFamily="monospace"
                android:letterSpacing="0.08" android:textStyle="bold" android:textSize="13sp"
                android:textColor="#F4F1EA" android:background="@drawable/quick_add_save_bg"
                android:paddingLeft="26dp" android:paddingRight="26dp"
                android:paddingTop="13dp" android:paddingBottom="13dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

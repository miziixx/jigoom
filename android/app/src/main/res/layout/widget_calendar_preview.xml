        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="3" android:textColor="#7A8F5A" android:fontFamily="monospace" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="4" android:textColor="#556B2F" android:fontFamily="monospace" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="5" android:textColor="#7A8F5A" android:fontFamily="monospace" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="6" android:textColor="#7A8F5A" android:fontFamily="monospace" android:textSize="9sp" android:gravity="center" />

<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview for calendar widget picker — no GridView/RemoteAdapter -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#EDF2ED">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[&lt;]"
            android:textColor="#7A8F5A"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:padding="4dp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026.06"
            android:textColor="#556B2F"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:gravity="center" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[&gt;]"
            android:textColor="#7A8F5A"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:padding="4dp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:background="#B0C4B0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Su" android:textColor="#7A8F5A" android:fontFamily="monospace"
            android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Mo" android:textColor="#7A8F5A" android:fontFamily="monospace"
            android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Tu" android:textColor="#7A8F5A" android:fontFamily="monospace"
            android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="We" android:textColor="#7A8F5A" android:fontFamily="monospace"
            android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Th" android:textColor="#7A8F5A" android:fontFamily="monospace"
            android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Fr" android:textColor="#7A8F5A" android:fontFamily="monospace"
            android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Sa" android:textColor="#7A8F5A" android:fontFamily="monospace"
            android:textSize="8sp" android:gravity="center" />
    </LinearLayout>

    <!-- Week rows (static) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="" android:textColor="#7A8F5A" android:fontFamily="monospace" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="" android:textColor="#7A8F5A" android:fontFamily="monospace" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="" android:textColor="#7A8F5A" android:fontFamily="monospace" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="" android:textColor="#7A8F5A" android:fontFamily="monospace" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="" android:textColor="#7A8F5A" android:fontFamily="monospace" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp"
    android:background="#0C0B09">

    <!-- accent dot — color set at runtime via setTextColor -->
    <TextView
        android:id="@+id/qa_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="·"
        android:textColor="#B8882A"
        android:fontFamily="monospace"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/qa_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="logroom"
        android:textColor="#5A5445"
        android:fontFamily="monospace"
        android:textSize="8sp"
        android:layout_marginTop="3dp"
        android:letterSpacing="0.08" />

</LinearLayout>

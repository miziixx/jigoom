<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_cell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="2dp">

    <TextView
        android:id="@+id/cal_cell_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#556B2F"
        android:fontFamily="monospace"
        android:textSize="10sp" />

    <!-- Dot indicator: visible when has memo. ImageView (RemoteViews-safe; plain View is not remotable) -->
    <ImageView
        android:id="@+id/cal_cell_dot"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:contentDescription="@null"
        android:background="#556B2F"
        android:visibility="gone" />

</LinearLayout>

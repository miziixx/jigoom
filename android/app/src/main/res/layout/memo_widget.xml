<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#EDF2ED">

    <!-- Title row -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[ MEMO ]"
        android:textColor="#556B2F"
        android:fontFamily="monospace"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/widget_divider1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="#B0C4B0" />

    <!-- Hint / tap area -->
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="&gt;_ tap to add memo..."
        android:textColor="#7A8F5A"
        android:fontFamily="monospace"
        android:textSize="10sp"
        android:gravity="center_vertical" />

    <LinearLayout
        android:id="@+id/widget_divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="5dp"
        android:background="#B0C4B0" />

    <!-- Button row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_checklist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☑"
            android:textColor="#7A8F5A"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:paddingLeft="2dp"
            android:paddingRight="5dp" />

        <TextView
            android:id="@+id/btn_format"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="≡"
            android:textColor="#7A8F5A"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:paddingLeft="2dp"
            android:paddingRight="5dp" />

        <TextView
            android:id="@+id/btn_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#"
            android:textColor="#7A8F5A"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:paddingLeft="2dp"
            android:paddingRight="5dp" />

        <TextView
            android:id="@+id/btn_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔"
            android:textSize="13sp"
            android:paddingLeft="2dp"
            android:paddingRight="5dp" />

        <!-- Store-only buttons (hidden in personal flavor) -->
        <TextView
            android:id="@+id/btn_simple"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[심플]"
            android:textColor="#7A8F5A"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:paddingLeft="2dp"
            android:paddingRight="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_discount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[할인]"
            android:textColor="#7A8F5A"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:paddingLeft="2dp"
            android:paddingRight="4dp"
            android:visibility="gone" />

        <!-- Spacer -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ADD]"
            android:textColor="#556B2F"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:paddingLeft="4dp"
            android:paddingRight="2dp" />
    </LinearLayout>

</LinearLayout>

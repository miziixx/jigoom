<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reminder_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:minWidth="280dp"
    android:background="#EDF2ED">

    <!-- [ SET REMINDER ] -->
    <TextView
        android:id="@+id/reminder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[ SET REMINDER ]"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:letterSpacing="0.1"
        android:textColor="#556B2F"/>

    <!-- Divider 1 -->
    <View
        android:id="@+id/reminder_div1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#B0C4B0"/>

    <!-- date: YYYY - MM - DD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/reminder_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="date: "
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#7A8F5A"/>

        <EditText
            android:id="@+id/reminder_year"
            android:layout_width="50dp"
            android:layout_height="32dp"
            android:inputType="number"
            android:maxLength="4"
            android:hint="YYYY"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#556B2F"
            android:gravity="center"
            android:padding="4dp"
            android:background="@null"
            android:imeOptions="actionNext"
            android:nextFocusDown="@id/reminder_month"/>

        <TextView
            android:id="@+id/reminder_sep1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - "
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#7A8F5A"/>

        <EditText
            android:id="@+id/reminder_month"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:inputType="number"
            android:maxLength="2"
            android:hint="MM"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#556B2F"
            android:gravity="center"
            android:padding="4dp"
            android:background="@null"
            android:imeOptions="actionNext"
            android:nextFocusDown="@id/reminder_day"/>

        <TextView
            android:id="@+id/reminder_sep2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - "
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#7A8F5A"/>

        <EditText
            android:id="@+id/reminder_day"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:inputType="number"
            android:maxLength="2"
            android:hint="DD"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#556B2F"
            android:gravity="center"
            android:padding="4dp"
            android:background="@null"
            android:imeOptions="actionNext"
            android:nextFocusDown="@id/reminder_hour"/>
    </LinearLayout>

    <!-- time: HH : MM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/reminder_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="time: "
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#7A8F5A"/>

        <EditText
            android:id="@+id/reminder_hour"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:inputType="number"
            android:maxLength="2"
            android:hint="HH"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#556B2F"
            android:gravity="center"
            android:padding="4dp"
            android:background="@null"
            android:imeOptions="actionNext"
            android:nextFocusDown="@id/reminder_min"/>

        <TextView
            android:id="@+id/reminder_sep3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" : "
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#7A8F5A"/>

        <EditText
            android:id="@+id/reminder_min"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:inputType="number"
            android:maxLength="2"
            android:hint="MM"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#556B2F"
            android:gravity="center"
            android:padding="4dp"
            android:background="@null"
            android:imeOptions="actionDone"/>
    </LinearLayout>

    <!-- Error text (hidden by default) -->
    <TextView
        android:id="@+id/reminder_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textColor="#EF5350"
        android:layout_marginTop="10dp"
        android:visibility="gone"/>

    <!-- Divider 2 -->
    <View
        android:id="@+id/reminder_div2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="#B0C4B0"/>

    <!-- [ CANCEL ]  [ SET ] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/reminder_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ CANCEL ]"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="#7A8F5A"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/reminder_btn_set"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ SET ]"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="#556B2F"
            android:layout_marginStart="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>

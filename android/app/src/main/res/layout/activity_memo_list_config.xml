<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#EDF2ED">

    <TextView
        android:id="@+id/config_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[ MEMO LIST WIDGET ]"
        android:textColor="#556B2F"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <View
        android:id="@+id/config_div1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#B0C4B0"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/config_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="// 표시할 폴더 또는 태그를 선택하세요"
        android:textColor="#7A8F5A"
        android:fontFamily="monospace"
        android:textSize="10sp"
        android:layout_marginBottom="10dp" />

    <ListView
        android:id="@+id/config_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#B0C4B0"
        android:dividerHeight="1dp" />

    <View
        android:id="@+id/config_div2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#B0C4B0"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/config_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ CANCEL ]"
            android:textColor="#7A8F5A"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/config_btn_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ ADD ]"
            android:textColor="#556B2F"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>

# Anthropic API 키 (서버리스 함수 api/reading.ts 에서만 사용, 클라이언트에 노출되지 않음)
ANTHROPIC_API_KEY=

# (선택) 리딩에 사용할 모델 오버라이드
# READING_MODEL=

# (선택) API 남용 방어 강화: 추가 허용 출처. 쉼표로 구분. 커스텀 도메인 쓸 때만 필요.
#  예) ALLOWED_ORIGINS=https://saju.example.com,https://www.saju.example.com
# ALLOWED_ORIGINS=

# (선택) /api/health 상세 진단 접근 토큰. 설정하면 이 값과 일치하는
#  x-diagnostic-token(또는 x-health-token) 헤더가 있을 때만 상세 정보를 보여준다.
#  미설정 시 /api/health 는 { status: "ok" } 최소 응답만 반환한다.
#  예) curl -H "x-diagnostic-token: <값>" https://.../api/health
# HEALTH_TOKEN=

# (선택) 정밀 rate limit. 아래 두 값을 채우면 인스턴스 메모리 대신 Upstash Redis로 승격된다.
#  https://upstash.com 에서 무료 Redis 생성 → REST URL/TOKEN 복사.
#  없으면 인스턴스 단위 인메모리 rate limit으로 자동 폴백(외부 의존 없이 동작).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── 텔레그램 개인비서 봇 (bot/, api/telegram-webhook.ts) ──

# 텔레그램 봇 토큰 (@BotFather 발급). 봇 실행에 필수.
# TELEGRAM_BOT_TOKEN=

# 개인 봇 접근 제한: 허용할 텔레그램 사용자 ID (쉼표 구분). 지정하면 이 사용자만 사용 가능.
#  TELEGRAM_ALLOWED_USER_IDS 와 ALLOWED_TELEGRAM_USER_IDS 둘 다 인식(합집합).
# TELEGRAM_ALLOWED_USER_IDS=
# ALLOWED_TELEGRAM_USER_IDS=

# (선택) 웹훅 진위 검증용 시크릿. setWebhook 시 등록한 값과 일치해야 처리.
# TELEGRAM_WEBHOOK_SECRET=

# (선택) 봇이 쓸 Claude 모델. 기본 claude-opus-4-8.
# BOT_MODEL=

# (선택) 맥락 인지 라우터 on/off. 기본 on(1). 0/false/off 로 끄면 LLM 라우팅 없이
#  키워드 분류만 쓴다(자연어/후속 질문 이해도가 낮아지지만 응답 지연·비용은 줄어듦).
# BOT_SMART_ROUTER=1

# (선택) 라우터가 쓸 빠른 분류 모델. 기본 claude-haiku-4-5-20251001.
# BOT_ROUTER_MODEL=

# (선택) 봇 답변 길이 상한 기본값: brief | normal | detailed. 기본 normal.
# BOT_VERBOSITY=

# (선택) Claude 온도. 미설정 시 SDK 기본값.
# BOT_TEMPERATURE=

# (선택) 대화 히스토리 세션 TTL(분). 마지막 메시지 후 이 시간 지나면 히스토리 자동 만료. 기본 45.
# BOT_HISTORY_TTL_MINUTES=

# (선택) 로컬 롱폴링(bot/index.ts) 저장 디렉터리. 기본 bot/data.
# BOT_DATA_DIR=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/reading.ts": {
      "maxDuration": 300
    },
    "api/fortune.ts": {
      "maxDuration": 60
    },
    "api/naming.ts": {
      "maxDuration": 120
    },
    "api/telegram-webhook.ts": {
      "maxDuration": 300
    }
  }
}

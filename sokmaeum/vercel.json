{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/reading.ts": {
      "maxDuration": 300
    },
    "api/fortune.ts": {
      "maxDuration": 60
    },
    "api/mystic.ts": {
      "maxDuration": 60
    }
  }
}
